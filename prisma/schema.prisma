generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id          Int          @id @default(autoincrement())
  userId      Int
  name        String
  phone       String?
  cnic        String?
  designation String
  salary      Decimal      @db.Decimal(12, 2)
  joiningDate DateTime
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance  Attendance[]

  @@index([userId])
  @@map("employees")
}

model Customer {
  id   Int    @id @default(autoincrement())
  name String

  @@map("customers")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  userId     Int
  employeeId Int
  date       DateTime
  inTime     String?
  outTime    String?
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([userId, employeeId, date])
  @@index([userId, employeeId])
  @@index([userId, date])
  @@map("attendance")
}

model GroceryItem {
  id             Int       @id @default(autoincrement())
  userId         Int
  itemName       String
  weight         Decimal   @db.Decimal(12, 3)
  quantity       Int
  rate           Decimal   @db.Decimal(12, 2)
  transportation Decimal   @db.Decimal(12, 2)
  sellingPrice   Decimal   @db.Decimal(12, 2)
  month          Int       @default(1)
  year           Int       @default(2024)
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemName, month, year])
  @@index([userId, month, year])
  @@index([userId, isClosed])
  @@map("grocery_items")
}

model SalesMonth {
  id             Int       @id @default(autoincrement())
  userId         Int
  month          Int
  year           Int
  openingBalance Decimal   @db.Decimal(12, 2)
  closingBalance Decimal?  @db.Decimal(12, 2)
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("sales_months")
}

model Sale {
  id            Int            @id @default(autoincrement())
  userId        Int
  salesMonthId  Int
  date          DateTime
  openingAmount Decimal        @db.Decimal(12, 2)
  expense       Decimal        @default(0) @db.Decimal(12, 2)
  cashAmount    Decimal        @default(0) @db.Decimal(12, 2)
  onlineAmount  Decimal        @default(0) @db.Decimal(12, 2)
  saleAmount    Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod  @default(CASH)
  onlineAccount OnlineAccount?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesMonth    SalesMonth     @relation(fields: [salesMonthId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, salesMonthId])
  @@map("sales")
}

enum CreditType {
  DAILY
  MONTHLY
}

model CreditCustomer {
  id              Int        @id @default(autoincrement())
  userId          Int
  personName      String
  creditType      CreditType @default(DAILY)
  creditDate      DateTime   @default(now())
  month           Int        @default(1)
  year            Int        @default(2024)
  isClosed        Boolean    @default(false)
  closedAt        DateTime?
  previousBalance Decimal    @default(0) @db.Decimal(12, 2)
  currentAmount   Decimal    @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, personName])
  @@index([userId, creditType])
  @@index([userId, year, month])
  @@map("credit_customers")
}

model VendorBill {
  id         Int          @id @default(autoincrement())
  userId     Int
  dateTime   DateTime     @default(now())
  vendorName String
  billAmount Decimal      @db.Decimal(12, 2)
  status     VendorStatus @default(UNPAID)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateTime])
  @@index([userId, status])
  @@map("vendor_bills")
}

model Investment {
  id              Int       @id @default(autoincrement())
  userId          Int
  dateTime        DateTime  @default(now())
  itemName        String
  weight          Decimal   @db.Decimal(12, 3)
  quantity        Int
  quantityPerPack Int
  rate            Decimal   @db.Decimal(12, 2)
  marketRate      Decimal   @db.Decimal(12, 2)
  month           Int       @default(1)
  year            Int       @default(2024)
  isClosed        Boolean   @default(false)
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateTime])
  @@index([userId, year, month])
  @@index([userId, isClosed])
  @@map("investments")
}

model Settings {
  id               Int      @id @default(autoincrement())
  storeName        String   @default("My Store")
  phone            String?
  address          String?
  currency         String   @default("PKR")
  taxRate          Decimal  @default(0) @db.Decimal(5, 2)
  invoicePrefix    String   @default("INV-")
  invoiceFooter    String   @default("Thank you for shopping with us.")
  workStartTime    String   @default("09:00")
  workEndTime      String   @default("18:00")
  lateAfterMinutes Int      @default(15)
  compactMode      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("settings")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           UserRole        @default(STAFF)
  phone          String?
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  employees      Employee[]
  attendances    Attendance[]
  groceryItems   GroceryItem[]
  salesMonths    SalesMonth[]
  sales          Sale[]
  creditCustomers CreditCustomer[]
  vendorBills    VendorBill[]
  investments    Investment[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum OnlineAccount {
  EASYPAISA
  BANK_ISLAMI
}

enum VendorStatus {
  PAID
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  OFF
  HALF_DAY
  LATE
}

enum UserRole {
  ADMIN
  STAFF
}

enum PaymentMethod {
  CASH
  ONLINE
}
